{
  "name": "ai-revenue-os-gateway",
  "version": "1.0.0",
  "description": "Plataforma inteligente de otimização de IA com múltiplos provedores",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "test": "node test/healthCheck.js",
    "test:watch": "nodemon test/healthCheck.js",
    "test:full": "npm run dev & sleep 2 && npm test",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build": "echo 'Build complete'",
    "docker:build": "docker build -t ai-revenue-os .",
    "docker:run": "docker run -p 3001:3001 --env-file .env.local ai-revenue-os"
  },
  "keywords": [
    "ai",
    "saas",
    "optimization",
    "openai",
    "claude",
    "gemini"
  ],
  "author": "Elvis Balbino",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.8.0",
    "@google/generative-ai": "^0.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.1.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "stripe": "^13.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.53.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
